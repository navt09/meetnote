# Copy to .env.local and fill in. .env.local is git-ignored.
# Never put real values in THIS file; it is committed to git.

# Anthropic (extraction + agent)
ANTHROPIC_API_KEY=

# Deepgram (transcription)
DEEPGRAM_API_KEY=

# Supabase — the meetnote project (NOT the Protegion organization).
# Used now for audio storage (bucket "recordings"); later for login and the database.
# The URL ends in .supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct database connection, used only by `npm run migrate` from your machine.
# Supabase dashboard > Connect > "Direct connection" (or Session pooler) URI, with the password filled in.
SUPABASE_DB_URL=

# Optional, local tooling only (never used by the app):
# Supabase personal access token (sbp_...) so migrations and project settings
# can be applied from your machine. supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
