# Copy to .env.local and fill in. .env.local is git-ignored.
# Never put real values in THIS file; it is committed to git.

# Anthropic (extraction + agent)
ANTHROPIC_API_KEY=

# Deepgram (transcription)
DEEPGRAM_API_KEY=

# Supabase — the meetnote project (NOT the Protegion organization).
# Used now for audio storage (bucket "recordings"); later for login and the database.
# The URL ends in .supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct database connection, used only by `npm run migrate` from your machine.
# Supabase dashboard > Connect > "Direct connection" (or Session pooler) URI, with the password filled in.
SUPABASE_DB_URL=

# Optional, local tooling only (never used by the app):
# Supabase personal access token (sbp_...) so migrations and project settings
# can be applied from your machine. supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Optional: comma-separated emails that may see internal numbers (what each
# meeting costs in vendor fees). Everyone else never sees them.
OWNER_EMAILS=

# Encrypts third-party connector credentials (Linear, Jira, Slack, Google) before
# they are stored. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this means every connection must be set up again; meetings are unaffected.
CREDENTIALS_KEY=

# Google OAuth (optional): lets a customer connect Gmail and Calendar.
# Create an OAuth client at console.cloud.google.com > APIs & Services > Credentials,
# type "Web application", with the redirect URI:
#   https://YOUR-DOMAIN/api/connectors/google/callback
# Note: gmail.send is a "sensitive" scope. Google's app verification is required
# before more than 100 people can connect, and while the app is in Testing mode
# each connection expires after 7 days.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Connector OAuth apps (optional). With these set, Settings shows a one-click
# "Connect" button instead of asking the customer to paste API keys.
# Each needs a callback URL of https://YOUR-DOMAIN/api/connectors/<name>/callback
#
# Linear: linear.app/settings/api/applications/new
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# Jira: developer.atlassian.com > Developer console > OAuth 2.0 integration
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# Slack: api.slack.com/apps > OAuth & Permissions
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Stripe (optional): what moves an account to Pro when someone pays.
# Without these, the product runs exactly as it does now and the upgrade
# buttons say payments are not set up.
#
# 1. dashboard.stripe.com/apikeys -> Secret key
STRIPE_SECRET_KEY=
# 2. Create a recurring Product and Price, then paste the PRICE id (price_...,
#    not the product id). Its amount must match PLANS in src/lib/site.ts.
STRIPE_PRICE_ID=
# 3. dashboard.stripe.com/webhooks -> Add endpoint
#      URL:    https://YOUR-DOMAIN/api/billing/webhook
#      Events: checkout.session.completed, customer.subscription.created,
#              customer.subscription.updated, customer.subscription.deleted
#    Paste the signing secret (whsec_...). Without it the webhook refuses every
#    call, which means nobody is ever moved to Pro.
STRIPE_WEBHOOK_SECRET=

# Where Stripe sends people back to. Set this in production: without it the
# return URL is taken from the request, and a redirect target read from a
# header is one an attacker can suggest.
NEXT_PUBLIC_SITE_URL=
