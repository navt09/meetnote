# Copy to .env.local and fill in. .env.local is git-ignored.
# Never put real values in THIS file; it is committed to git.

# Anthropic (extraction + agent)
ANTHROPIC_API_KEY=

# Deepgram (transcription)
DEEPGRAM_API_KEY=

# Supabase — the meetnote project (NOT the Protegion organization).
# Used now for audio storage (bucket "recordings"); later for login and the database.
# The URL ends in .supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct database connection, used only by `npm run migrate` from your machine.
# Supabase dashboard > Connect > "Direct connection" (or Session pooler) URI, with the password filled in.
SUPABASE_DB_URL=

# Optional, local tooling only (never used by the app):
# Supabase personal access token (sbp_...) so migrations and project settings
# can be applied from your machine. supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Optional: comma-separated emails that may see internal numbers (what each
# meeting costs in vendor fees). Everyone else never sees them.
OWNER_EMAILS=

# Encrypts third-party connector credentials (Linear, Jira, Slack, Google) before
# they are stored. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this means every connection must be set up again; meetings are unaffected.
CREDENTIALS_KEY=

# Google OAuth (optional): lets a customer connect Gmail and Calendar.
# Create an OAuth client at console.cloud.google.com > APIs & Services > Credentials,
# type "Web application", with the redirect URI:
#   https://YOUR-DOMAIN/api/connectors/google/callback
# Note: gmail.send is a "sensitive" scope. Google's app verification is required
# before more than 100 people can connect, and while the app is in Testing mode
# each connection expires after 7 days.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
